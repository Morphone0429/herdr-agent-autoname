{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "mods/agent-autoname/engine.js",
    "mods/agent-autoname/runner.mjs",
    "scripts/*.mjs",
    "tests/*.mjs"
  ],
  "exclude": [
    "mods/*/main.js",
    "node_modules"
  ]
}
